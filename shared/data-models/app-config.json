    "language": "fr",
    "rss_enabled": true,
    "export_include_notes": true,
    "statistics_cache_days": 30,
    "notification_enabled": false
  },
  "export_formats": [
    {
      "format": "pdf",
      "description": "Rapport complet avec graphiques",
      "extension": ".pdf",
      "mime_type": "application/pdf"
    },
    {
      "format": "csv",
      "description": "Données tabulaires pour tableur",
      "extension": ".csv",
      "mime_type": "text/csv"
    },
    {
      "format": "json",
      "description": "Données brutes structurées",
      "extension": ".json",
      "mime_type": "application/json"
    }
  ],
  "chart_types": [
    {
      "type": "line",
      "name": "Graphique linéaire",
      "description": "Évolution dans le temps"
    },
    {
      "type": "bar",
      "name": "Graphique en barres",
      "description": "Comparaison des quantités"
    },
    {
      "type": "pie",
      "name": "Graphique circulaire",
      "description": "Répartition par catégorie"
    }
  ],
  "time_periods": [
    {
      "id": "week",
      "name": "Semaine",
