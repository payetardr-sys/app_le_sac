      "enabled": true,
      "update_frequency": 3600,
      "category": "Information"
    },
    {
      "id": 2,
      "url": "https://www.federationaddiction.fr/feed/",
      "title": "Fédération Addiction",
      "description": "Actualités de la Fédération Addiction",
      "enabled": true,
      "update_frequency": 3600,
      "category": "Actualités"
    }
  ],
  "default_products": [
    {
      "name": "Bière",
      "category": "alcool",
      "default_unit": "ml",
      "icon": "🍺",
      "color": "#FFA500"
    },
    {
      "name": "Vin",
      "category": "alcool",
      "default_unit": "ml",
      "icon": "🍷",
      "color": "#8B0000"
    },
    {
      "name": "Spiritueux",
      "category": "alcool",
      "default_unit": "ml",
      "icon": "🥃",
      "color": "#CD853F"
    },
    {
      "name": "Cigarette",
      "category": "tabac",
