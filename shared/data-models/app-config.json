    },
    {
      "id": "month",
      "name": "Mois",
      "days": 30
    },
    {
      "id": "quarter",
      "name": "Trimestre",
      "days": 90
    },
    {
      "id": "year",
      "name": "Année",
      "days": 365
    }
  ]
