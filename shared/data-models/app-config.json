    {
      "name": "Cannabis",
      "category": "cannabis",
      "default_unit": "g",
      "icon": "🌿",
      "color": "#228B22"
    }
  ],
  "app_settings": {
    "pin_enabled": true,
    "auto_lock_timeout": 60,
